# Line endings are decided here, not by a client setting.
#
# Why it matters: many Windows machines have core.autocrlf=true. Without this
# file a clone would give .sh files CRLF, bash inside WSL would trip over every
# '\r', and the install would fail with an opaque error on the very first line.
# The other side of it: Windows must see .cmd and .vbs with CRLF.
* text=auto eol=lf

*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.vbs  text eol=crlf

*.png  binary
*.ico  binary
*.jinja text eol=lf
