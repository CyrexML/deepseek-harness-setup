# Patch for the web profile: the route to the local llama-server.
# Repeats what was verified on the headless profile, minus the task-specific
# parts: the web profile keeps its tools behind agent presets rather than in the
# loader tree, so only the provider and the model are chosen here.

# The native DeepSeek provider is disabled: it requires DEEPSEEK_API_KEY and
# otherwise fails with MISSING_CREDENTIAL at request time.
- id: llm-deepseek
  disabled: true

# Route to llama-server running natively on Windows.
# api: openai-completions is pi-ai's wire protocol.
# The address is NOT a constant: the WSL->Windows gateway changes when WSL
# restarts, so it comes from the environment.
- id: llm-pi-ai
  config:
    providers:
      qwen-local:
        api: openai-completions
        baseURL: !!js process.env.DSH_LLAMA_BASE_URL
        apiKeyEnv: DSH_LLAMA_KEY
        # Vision. The projector runs on the CPU, so an image costs roughly its
        # pixel count: 824x1800 took about 2 minutes each, and after a context
        # compaction every image of the turn is re-encoded - more than 5 minutes
        # of silence, a `pi-ai stream idle timeout`, a retry, and encoding again.
        # requestImagePixelBudget makes DSH shrink ANY image to the budget
        # (412x900 is about 360 tokens and ~25 s); streamIdleTimeoutMs covers
        # re-encoding several images in a row.
        requestImagePixelBudget: 370800
        streamIdleTimeoutMs: 900000
        models:
          - id: @MODEL_ID@
            # Equals the server's -c (@CTX@). Workarounds through a fake
            # "131072 window" were dropped: the root cause (pi-ai clamping
            # max_tokens by a character estimate) is fixed by the patch to the
            # compiled llm-pi-ai - the replay carries server usage and the
            # estimate anchors on it. ensure-patches.sh re-applies that patch on
            # every web start.
            # Claude dsh-context-audit-2026-09-12.
            contextWindow: @CTX@
            # 12288 - do NOT lower to 8192: the ceiling has to hold
            # --reasoning-budget 5000 PLUS the largest legitimate tool call
            # (writing a 12 KB script is about 3.5k). At 8192 a fifth rewrite of
            # a file was cut off and agent-loop ended the turn on max-tokens
            # (agent.ts:468) - there is no auto-continuation, so the task stalled.
            # Output p99 per step is 6-7k, and that tail is legitimate work.
            maxTokens: 12288
            # Vision. Without this line dsh refuses before the server does: the
            # route default is DEFAULT_INPUT = ['text'] and the llm-pi-ai adapter
            # drops the request with UNSUPPORTED_CONTENT.
            # ("model does not support image input", adapter.ts §generate).
            # This declares what the endpoint can do, it does not verify it: the
            # server must be started with --mmproj or the refusal simply moves one
            # level down. Measured: the projector on the CPU does not hurt
            # generation, and one 900x600 image takes about 20 s to encode.
            input: [text, image]
            # Reasoning levels. Without this field a manually declared model
            # counts as NON-reasoning: llm/src/index.ts:870 then rejects any
            # explicit effort, including "off" - which graph-memory always sends
            # (dist/dsh.js:93). That is what quarantined 50 messages and left the
            # graph empty.
            # `off:` is DELIBERATELY valueless: catalog.ts:653 reads that as "the
            # level is supported, send nothing", so the request stays byte for
            # byte the same. At least one level above off must be declared
            # (catalog.ts:701), hence low.
            reasoningEfforts:
              off:
              low: low

          # A separate entry for THE SAME model, used by the compactor with
          # thinking unconditionally off. llama-server does not check the model
          # name, so the second entry is only a different set of request
          # parameters, not a different model.
          #
          # Why this and not an effort: the compactor (dsh-compaction-basic) has
          # no reasoning knob at all - its schema holds only thresholdRatio,
          # retainRatio, retainTokens, summarizationProvider, summarizationModel,
          # maxTokens, compactionRetries, maxOverflowRetries (config.ts §27).
          # so the only way to reach the request is to send it down its own route.
          #
          # thinkingFormat is required: pi-ai reads chat_template_kwargs ONLY
          # under two chat-template formats (catalog.ts §369); under the others
          # they are never sent. `chat-template` is used rather than
          # `qwen-chat-template`, because the latter sends enable_thinking as
          # `!!reasoningEffort` and ignores the literal set here.
          # (openai-completions.js:584), while under `chat-template` the literal
          # value goes onto the wire as it is (buildChatTemplateValues:720).
          #
          # reasoningEfforts is declared because EVERY dispatch branch is gated on
          # `model.reasoning` (openai-completions.js:575-595): for a non-reasoning
          # model the kwargs are never sent and the Qwen3 template would think by
          # its own default.
          - id: qwen38-27b-nothink
            # Equals the server's -c; the summary replay carries no reasoning
            # (compaction-notools.mjs) and is anchored on usage (llm-pi-ai patch).
            contextWindow: @CTX@
            maxTokens: 8192
            input: [text]
            reasoningEfforts:
              off:
              low: low
            compat:
              thinkingFormat: chat-template
              chatTemplateKwargs:
                enable_thinking: false

# Cap on bash output. The package default of 64000 tail bytes (bash-local
# src/index.ts:109; bash-sandbox uses the same Config) is about 18k tokens - one
# call larger than a whole cycle between compactions. Measured: two `node -e`
# outputs of 43283 and 24485 characters. 16000 is about 4.5k tokens, and the tool
# spills the full output to a file and prints its path anyway. A patch replaces a
# row's whole config, so timeoutMs from dsh-base is repeated here.
- id: bash-sandbox
  config:
    timeoutMs: 60000
    maxOutputBytes: 16000
- id: agent-default-model
  config:
    provider: qwen-local
    model: @MODEL_ID@

# Default agent preset.
#
# The compactor's thresholdRatio cannot be set from here: in the web profile the
# compaction-basic row is disabled in the host plan and the live instance comes
# from the agent preset composition, which a profile patch cannot reach. The
# preset layer has no patch semantics of its own - see the dsh-agent-presets
# README, section
# Known Limitations: "there is no patch semantics at this layer to express
# 'standard plus one change'". So the preset is copied whole into
# ~/.dsh/.agent-presets/local-64k, and this file only selects that copy.
#
# The copy differs from the stock standard preset: thresholdRatio 0.75,
# retainRatio 0.25, compactor maxTokens 3072, instruction maxBytes 6144, the web
# tool limits and three anchored modules (tool-bootstrap,
# dev-tool-search, compaction-epoch).
#
# The copy does not update with dsh: after an upgrade it has to be re-taken from
# the new standard preset and the changes above re-applied.
#
# The live value still comes from ~/.dsh/settings.yaml (agent-presets.default),
# written by the "Set as default" button; this line is only a fallback.
- id: agent-presets
  config:
    default: local-64k
