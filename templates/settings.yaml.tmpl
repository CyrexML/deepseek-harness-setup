# harness-stand
ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1
ui-chat:
  transcriptView: compact
agent-presets:
  default: @PRESET@
subagent-model-selection:
  enabled: true
  allowedModels:
    - provider: qwen-local
      model: @MODEL_ID@
locale:
  preference: en
dsh-better-sidebar:
  openByDefault: true
  tabsEnabled:
    terminal: false
    diff: false
    sidechat: false
    browser: true
  agentOpenTools: true
  defaultWidthPercent: 30
  browserInterceptHttps: true
  browserInterceptHttp: true
  # The preview renders the page in a sandboxed iframe without allow-same-origin,
  # i.e. with an opaque origin. The core's trust fence rejects Origin: null, so
  # EVERY sub-resource (<script src>, <link>) gets a 403 while the page itself
  # loads, because a top-level navigation carries no Origin header. With all the
  # code inline this never showed; splitting it into js/*.js made the preview
  # useless. The one-off button in the status bar lives in component state and
  # resets when the host restarts, hence the flag here.
  # THE COST: a previewed page runs with the interface's own origin and can read
  # and write session files. Keep it for your own projects only.
  htmlViewerNoSandbox: true
  workspaceFence: false
agent-default-model:
  provider: qwen-local
  model: @MODEL_ID@
ui-theme:
  preference: system
