# harness-stand
ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1
ui-chat:
  transcriptView: compact
agent-presets:
  default: @PRESET@
subagent-model-selection:
  enabled: true
  allowedModels:
    - provider: qwen-local
      model: @MODEL_ID@
locale:
  preference: en
dsh-better-sidebar:
  openByDefault: true
  tabsEnabled:
    terminal: false
    diff: false
    sidechat: false
    browser: true
  agentOpenTools: true
  defaultWidthPercent: 30
  browserInterceptHttps: true
  browserInterceptHttp: true
  # Превью рендерит страницу в песочном iframe без allow-same-origin, то есть
  # с opaque origin. Фенс доверия ядра отвергает Origin: null, поэтому КАЖДЫЙ
  # подресурс (<script src>, <link>) получает 403, а сама страница грузится:
  # навигация верхнего уровня заголовка Origin не несёт. Пока весь код был
  # инлайновым, это не проявлялось; разрезка на js/*.js сделала превью
  # нерабочим. Разовая кнопка в строке статуса живёт в состоянии компонента и
  # сбрасывается при перезапуске хоста, поэтому флаг здесь.
  # ЦЕНА: страница в превью исполняется с origin самого интерфейса и может
  # читать и писать файлы сессии. Держать только для своих проектов.
  htmlViewerNoSandbox: true
  workspaceFence: false
agent-default-model:
  provider: qwen-local
  model: @MODEL_ID@
ui-theme:
  preference: system
